# Copy to .env and fill in. Vars must be VITE_-prefixed to reach the browser.
# WARNING: Vite inlines every VITE_ var into the client bundle — they are publicly visible.
#
# The keys at the bottom of this file are deliberately NOT VITE_-prefixed. They are used
# only by scripts/*.mjs at build time, so they stay out of the bundle. Keep it that way.

# Alchemy — https://dashboard.alchemy.com (create an app, copy the API key)
# Used by src/services/alchemy.js to fetch NFTs. If blank, the gallery falls
# back to hardcoded mock NFTs (picsum placeholder images).
VITE_ALCHEMY_API_KEY=

# Default chain for calls that don't name one. The brand registry names its own
# chain per collection (see NETWORKS in src/services/alchemy.js), so make sure every
# chain you use is ENABLED on your Alchemy app — a disabled network returns 403 and
# that brand's grid will come up empty. Ethereum + Base cover the current registry.
VITE_ALCHEMY_NETWORK=eth-mainnet

# MIND / Hellominds builder API key (JWT). src/services/mind.js base64-decodes
# the JWT payload to read `humanId`, so a non-JWT string will not work.
# If blank, the chat interface is non-functional ("No API Key configured"), but
# browsing brands and collections still works.
VITE_MIND_API_KEY=

# Which mind answers. Strongly recommended: if blank, mind.js falls back to the FIRST
# mind on the account, which is arbitrary and may not have a video skill.
# List your minds with:  node --env-file=.env -e "…client.listMinds({})"  (see mind.js)
VITE_MIND_ID=

# Optional. The conversation alias, i.e. which thread the app talks in. Defaults to
# `studio-<first 8 chars of VITE_MIND_ID>`. An alias is permanently bound to the mind
# it was created with, so don't point two different minds at the same alias — set this
# only when you deliberately want to resume a specific existing thread.
VITE_MIND_ALIAS=

# x402 licensing service (../x402-nft-licensing). NOT USED YET — the UI presents
# licensing state and pricing from src/config/licensing.js; no request is made until
# the integration lands. Set this to the deployed service's base URL when it does.
VITE_X402_API_BASE=


# ---------------------------------------------------------------- build-time only
# No VITE_ prefix on anything below. These never reach the browser.

# MiniMax (Hailuo) — https://platform.minimax.io. Used by scripts/gen-video.mjs to render
# the hero background film from the real on-chain artwork:
#
#   npm run prep:refs                      # pull the reference art off chain
#   npm run gen:video -- --probe showroom  # cheap 768P test render
#   npm run gen:video -- --hero            # the 2K hero clip
#   npm run encode:hero -- assets/renders/hero-1.mp4
#
# The result is committed to public/hero/ and served as a static file, so a visitor's page
# load never calls MiniMax. Note the global tenant is api.minimax.io; keys for the
# mainland-China tenant (api.minimaxi.com) are not interchangeable.
MINIMAX_API_KEY=

# Optional override for the above, e.g. https://api.minimaxi.com
# MINIMAX_BASE_URL=

# RunPod. Present in the original .env but not referenced anywhere in this codebase.
# RUNPOD_API_KEY=


# ------------------------------------------------------------------ worker (.dev.vars)
# The agent swarm in worker/ does NOT read this file. Cloudflare Workers have their own
# secret mechanism, so copy the block below into a `.dev.vars` file (gitignored) for
# `npm run dev:worker`, and use `wrangler secret put NVIDIA_API_KEY` for the deployed one.
#
#   NVIDIA_API_KEY=nvapi-...
#
# Get a key at https://build.nvidia.com — "Generate API Key" on any model page.
#
# Two things to know before building on it, both verified rather than assumed:
#   1. The credits system was REMOVED in 2025. The "1,000 free credits" figure in every
#      blog post is stale; what you actually get is a rate limit, community-observed at
#      ~40 requests/min per model, account-level, with no free-tier increases.
#   2. The API Trial terms are evaluation-only. Prototype freely, but do not point
#      production traffic at integrate.api.nvidia.com.
#
# Both are survivable because worker/nvidia.js is a thin OpenAI-compatible shim and the
# base URL lives in wrangler.jsonc `vars` — OpenRouter serves the same weights when it is
# time to move. The KV dossier cache does the rest, since a piece is only ever analysed
# once.
#
#   PINATA_JWT=eyJ...
#
# IPFS pinning for finished takes (worker/director-job.js `pin`). Create a free account at
# https://app.pinata.cloud, then API Keys → New Key: Admin OFF, V3 Resources → Files: Write,
# everything else None, Legacy Endpoints untouched → Create → copy the JWT (shown once).
# Optional: PINATA_GATEWAY=https://<your-dedicated>.mypinata.cloud to build gateway links
# against a dedicated gateway instead of the public one. Without PINATA_JWT every take still
# reaches the Mind's [Filmography] record — with a 7-day link and no permanent ipfs:// address.
# Deployed: `wrangler secret put PINATA_JWT`. Check with GET /api/health → hasPinataKey.
